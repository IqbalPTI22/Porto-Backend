@baseUrl = http://localhost:3000
@projectId = 1
@skillId = 1
@profileId = 1

### Health Check
GET {{baseUrl}}/health

### =========================
### Projects CRUD
### =========================

### Get all projects
GET {{baseUrl}}/projects

### Get project by id
GET {{baseUrl}}/projects/{{projectId}}

### Create project
POST {{baseUrl}}/projects
Content-Type: application/json

{
  "title": "New Portfolio Feature",
  "description": "Add blog section and improve SEO.",
  "imageUrl": "https://example.com/project-image.jpg",
  "projectUrl": "https://example.com/project-url"
}

### Update project
PUT {{baseUrl}}/projects/{{projectId}}
Content-Type: application/json

{
  "title": "Updated Portfolio Feature"
}

### Delete project
DELETE {{baseUrl}}/projects/{{projectId}}

### =========================
### Skills CRUD
### =========================

### Get all skills
GET {{baseUrl}}/skills

### Get skill by id
GET {{baseUrl}}/skills/{{skillId}}

### Create skill
POST {{baseUrl}}/skills
Content-Type: application/json

{
  "name": "Node.js",
  "level": "Advanced",
  "category": "Backend"
}

### Update skill
PUT {{baseUrl}}/skills/{{skillId}}
Content-Type: application/json

{
  "level": "Expert"
}

### Delete skill
DELETE {{baseUrl}}/skills/{{skillId}}

### =========================
### Profile CRUD
### =========================

### Get all profile records
GET {{baseUrl}}/profile

### Get profile by id
GET {{baseUrl}}/profile/{{profileId}}

### Create profile
POST {{baseUrl}}/profile
Content-Type: application/json

{
  "fullName": "Jane Developer",
  "headline": "Full Stack Engineer",
  "bio": "Focused on scalable web architecture and product delivery.",
  "email": "jane@example.com",
  "location": "Bandung, Indonesia",
  "avatarUrl": "https://example.com/avatar.jpg"
}

### Update profile
PUT {{baseUrl}}/profile/{{profileId}}
Content-Type: application/json

{
  "headline": "Senior Full Stack Engineer"
}

### Delete profile
DELETE {{baseUrl}}/profile/{{profileId}}
