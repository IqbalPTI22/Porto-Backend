@baseUrl = http://localhost:3000
@projectId = 1
@skillId = 1
@activityUpdateId = 1
@setupKey = change-me
@adminEmail = admin@example.com
@adminPassword = change-me-strong-password
@authToken = paste-jwt-token-here

### Health Check
GET {{baseUrl}}/health

### =========================
### Authentication
### =========================

### One-time admin setup
POST {{baseUrl}}/auth/setup
Content-Type: application/json
x-setup-key: {{setupKey}}

{
  "name": "Main Admin",
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### Admin login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### =========================
### Projects CRUD
### =========================

### Get all projects
GET {{baseUrl}}/projects

### Get project by id
GET {{baseUrl}}/projects/{{projectId}}

### Create project
POST {{baseUrl}}/projects
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "title": "New Portfolio Feature",
  "description": "Add blog section and improve SEO.",
  "imageUrl": "https://example.com/project-image.jpg",
  "projectUrl": "https://example.com/project-url"
}

### Update project
PUT {{baseUrl}}/projects/{{projectId}}
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "title": "Updated Portfolio Feature"
}

### Delete project
DELETE {{baseUrl}}/projects/{{projectId}}
Authorization: Bearer {{authToken}}

### =========================
### Skills CRUD
### =========================

### Get all skills
GET {{baseUrl}}/skills

### Get skill by id
GET {{baseUrl}}/skills/{{skillId}}

### Create skill
POST {{baseUrl}}/skills
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "Node.js",
  "level": "Advanced",
  "category": "Backend"
}

### Update skill
PUT {{baseUrl}}/skills/{{skillId}}
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "level": "Expert"
}

### Delete skill
DELETE {{baseUrl}}/skills/{{skillId}}
Authorization: Bearer {{authToken}}

### =========================
### Profile (Singleton)
### =========================

### Get profile
GET {{baseUrl}}/profile

### Edit profile
PUT {{baseUrl}}/profile
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "fullName": "Jane Developer",
  "headline": "Full Stack Engineer",
  "bio": "Focused on scalable web architecture and product delivery.",
  "email": "jane@example.com",
  "location": "Bandung, Indonesia",
  "avatarUrl": "https://example.com/avatar.jpg"
}

### =========================
### Activity Updates CRUD
### =========================

### Get all activity updates
GET {{baseUrl}}/activity-updates

### Get activity update by id
GET {{baseUrl}}/activity-updates/{{activityUpdateId}}

### Create activity update
POST {{baseUrl}}/activity-updates
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "mediaType": "image",
  "mediaUrl": "https://example.com/posts/post-image.jpg",
  "title": "Company Gathering",
  "caption": "Sharing highlights from our monthly activity.",
  "activityTime": "2026-03-12T10:30:00.000Z",
  "uploadedBy": "user"
}

### Update activity update
PUT {{baseUrl}}/activity-updates/{{activityUpdateId}}
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "title": "Company Gathering 2026"
}

### Delete activity update
DELETE {{baseUrl}}/activity-updates/{{activityUpdateId}}
Authorization: Bearer {{authToken}}
